# ---------------------------------------------------------------------------
# FCC Bridge configuration
# Copy this file to .env and adjust values. Never commit .env (it may hold
# secrets). See README.md for the curl smoke-test command.
# ---------------------------------------------------------------------------

# Bridge HTTP server. Bound to 127.0.0.1 by default so the bridge is
# localhost-only. Set BIND_HOST=0.0.0.0 and ENABLE_NETWORK=true only if you
# explicitly want to expose the bridge on the network.
PORT=8787
BIND_HOST=127.0.0.1
ENABLE_NETWORK=false

# Free Claude Code runtime (real backend, never mocked).
FCC_BASE_URL=http://127.0.0.1:8082

# Proxy auth forwarded to FCC. Only needed when PROXY_AUTH_ENABLED=true on the
# FCC side. FCC defaults to disabled with token "freecc".
FCC_PROXY_AUTH_ENABLED=false
FCC_PROXY_AUTH_TOKEN=freecc

# Default permission mode: plan | manual | auto-edit
# plan   = read-only, no file/terminal/MCP changes
# manual = sensitive actions require explicit approval
# auto-edit = auto edits inside workspace; block out-of-workspace/dangerous cmds
DEFAULT_PERMISSION_MODE=manual

# Workspace root the bridge is allowed to operate inside (auto-edit mode).
# Leave empty to disable workspace-scoped auto edits.
WORKSPACE_PATH=

# CORS. Disabled by default (localhost-only). Enable only with ENABLE_NETWORK=true.
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=info
